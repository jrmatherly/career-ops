# Publish service environment. Copy to publish/.env (gitignored) or set in the
# container; every value below is a placeholder.

# Signs share-page access cookies and feedback tokens. `openssl rand -hex 32`.
PUBLISH_SECRET=

# Better Auth: the service's public origin (what the browser shows, no trailing
# slash), and the secret that signs sessions and encrypts stored OAuth tokens.
# `openssl rand -hex 32`. Rotating it signs everyone out.
PUBLISH_BASE_URL=https://cv.example.com
PUBLISH_AUTH_SECRET=

# Pocket ID OIDC client. Register the callback URL
# ${PUBLISH_BASE_URL}/api/auth/callback/pocket-id in Pocket ID.
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=
POCKET_ID_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration

# Comma-separated emails allowed to sign in to the account page.
PUBLISH_ALLOWED_EMAILS=you@example.com

# Optional.
PUBLISH_BIND=127.0.0.1
PUBLISH_PORT=8080
PUBLISH_DB=publish.db
PUBLISH_CLIENT_IP_HEADER=cf-connecting-ip
PUBLISH_TRUSTED_PROXIES=

# Share CLI side (the data root's .env, not the service's): the service URL and
# a key created on ${PUBLISH_BASE_URL}/account.
# PUBLISH_URL=https://cv.example.com
# PUBLISH_API_KEY=cops_...
