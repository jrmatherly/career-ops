.git
# Patterns are anchored at the context root, so a bare `node_modules` skips
# only the root one. web/node_modules and scaffolder/node_modules count too.
**/node_modules
output
batch/logs
batch/batch-state.tsv
batch/batch-input.tsv
batch/tracker-additions
jds/*
!jds/.gitkeep
reports
.env
.update-dismissed
.update-lock
*.log
.DS_Store
writing-samples

# deploy/Dockerfile copies the whole checkout, so every user-layer and local-only path must be listed here.
cv.md
article-digest.md
voice-dna.md
portals.yml
config/profile.yml
config/plugins.yml
config/cv-facts.json
config/privacy.yml
config/local-paths.txt
data
documents
interview-prep
modes/_profile.md
modes/_custom.md
modes/_brief.md
.career-ops-web
plugins.local
plugins.lock
opencode.json
.claude/settings.json
.claude/hooks
# Per-application CVs and cover letters saved under templates/. The shipped
# cv-template* and cover-letter-template* files stay in the context.
templates/cv-*.html
!templates/cv-template*.html
templates/cover-*.html
!templates/cover-letter-template*.html

# Gitignored local working trees
private
.codegraph
.remember
.serena
.claude/worktrees
.claude/settings.local.json
.tmp-*

# Build output
**/.next
dashboard/career-dashboard
dashboard/career-dashboard.exe
